# Brevo (https://app.brevo.com)
# Settings → API Keys → Generate a new API key
BREVO_API_KEY=your_brevo_api_key_here

# Contacts → Lists → create a list and copy its numeric ID
BREVO_LIST_ID=1

# Verified sender in Brevo (Settings → Senders & IPs)
# Leave empty to skip the welcome confirmation email
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=Banca Remota
