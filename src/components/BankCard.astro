---
// variant="header": bank identity block atop each column in dial.astro.
// variant="tab": clickable bottom tab-bar button (mobile). Active/inactive
//   styling is pure CSS off the [data-bank-tab][data-active] + --bank-hex
//   custom property (see site.css) — dialTabs.js only ever flips the
//   data-active attribute + the sibling panel's `hidden` class, no imperative
//   style computation needed.
interface Props {
  variant?: 'header' | 'tab';
  bankId: string;
  shortName: string;
  name?: string;
  hex: string;
  active?: boolean;
}
const { variant = 'header', bankId, shortName, name = '', hex, active = false } = Astro.props;
---

{
  variant === 'tab' ? (
    <button
      type="button"
      class="flex-1 flex flex-col items-center justify-center py-2 gap-1 cursor-pointer"
      data-bank-tab={bankId}
      data-active={active ? 'true' : 'false'}
      style={`--bank-hex:${hex}`}
    >
      <span class="tab-icon-pill" data-tab-pill>
        <img src={`/assets/banks/${bankId}-icon.svg`} alt={shortName} class="w-4 h-4 object-contain dark:invert" data-tab-icon />
      </span>
      <span class="text-[0.7rem] font-bold" data-tab-label>{shortName}</span>
    </button>
  ) : (
    <div class="w-full flex items-center gap-3 mb-3">
      <span
        class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 p-2"
        style={`background: color-mix(in srgb, ${hex} 16%, transparent)`}
      >
        <img src={`/assets/banks/${bankId}-icon.svg`} alt={shortName} class="w-full h-full object-contain dark:invert" />
      </span>
      <span class="min-w-0">
        <p class="font-extrabold text-gray-900 dark:text-white leading-tight">{shortName}</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate">{name}</p>
      </span>
    </div>
  )
}
