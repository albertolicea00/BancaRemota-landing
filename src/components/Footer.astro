---
// Verbatim port of the original footer. Section-anchor links (#features, #faq,
// etc.) only exist on the index page, so they're prefixed with "/" when this
// renders from any other page (currently just dial.astro).
const isIndex = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const home = isIndex ? '' : '/';
---

<footer
  class="bg-gray-50 dark:bg-gray-950 text-gray-600 dark:text-gray-400 py-16 px-4 sm:px-6 lg:px-8 border-t border-gray-200 dark:border-gray-800 transition-colors duration-300"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/assets/icon-black.png" alt="Banca Remota" class="w-8 h-8 rounded-lg shadow-sm dark:hidden" />
          <img src="/assets/icon-white.png" alt="Banca Remota" class="w-8 h-8 rounded-lg shadow-sm hidden dark:block" />
          <span class="text-gray-900 dark:text-white font-bold text-lg">Banca Remota</span>
        </div>
        <p class="text-sm leading-relaxed mb-4 text-gray-500 dark:text-gray-400">
          App nativa para iPhone que simplifica las operaciones bancarias cubanas mediante USSD. Sin internet.
        </p>
      </div>

      <div>
        <h4 class="text-gray-900 dark:text-white font-semibold mb-4 text-sm">Navegación</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${home}#features`} class="footer-link">Funciones</a></li>
          <li><a href={`${home}#how-it-works`} class="footer-link">Cómo funciona</a></li>
          <li><a href={`${home}#manual`} class="footer-link">Manual de uso</a></li>
          <li><a href={`${home}#faq`} class="footer-link">FAQ</a></li>
          <li><a href={`${home}#roadmap`} class="footer-link">Roadmap</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-gray-900 dark:text-white font-semibold mb-4 text-sm">Proyecto</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="https://github.com/albertolicea00/BancaRemota" target="_blank" rel="noopener" class="footer-link">GitHub</a></li>
          <li><a href="https://github.com/albertolicea00/BancaRemota/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="footer-link">Contribuir</a></li>
          <li><a href="https://github.com/albertolicea00/BancaRemota/issues" target="_blank" rel="noopener" class="footer-link">Reportar bug</a></li>
          <li><a href="https://github.com/albertolicea00/BancaRemota/releases" target="_blank" rel="noopener" class="footer-link">Releases</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-gray-900 dark:text-white font-semibold mb-4 text-sm">Comunidad</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://t.me/BancaRemotaCuba" target="_blank" rel="noopener" class="footer-link flex items-center gap-2">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
              </svg>
              Telegram
            </a>
          </li>
          <li>
            <a href="https://github.com/albertolicea00" target="_blank" rel="noopener" class="footer-link flex items-center gap-2">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.54-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02.005 2.04.14 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/albertolicea00" target="_blank" rel="noopener" class="footer-link flex items-center gap-2">
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-200 dark:border-gray-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-600 dark:text-gray-600">
      <p>
        © <span data-current-year>{new Date().getFullYear()}</span> Alberto Licea. Inspirada en la app original de
        <a href="https://www.linkedin.com/in/henrycruzmederos" target="_blank" rel="noopener" class="hover:text-gold underline transition-colors">Henry Cruz</a>.
      </p>
      <div class="flex gap-4 items-center">
        <a href="https://github.com/albertolicea00/BancaRemota/blob/main/LICENSE" target="_blank" rel="noopener" class="hover:text-gold transition-colors">MIT License</a>
        <span class="text-gray-800">·</span>
        <span>App nativa iOS · Sin internet · Datos locales</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // Recompute at load (not just at build time) so the copyright year stays
  // correct for as long as the static build is deployed.
  document.querySelectorAll('[data-current-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>
